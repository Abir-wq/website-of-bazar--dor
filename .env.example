# npm run setup generates .env.local with a unique secret for local use.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_PATH=./data/bazar-dor.db
# Optional: leave empty until OAuth apps are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional custom upstream. The assignment's three APIs are tried automatically.
BAZAR_API_URL=
